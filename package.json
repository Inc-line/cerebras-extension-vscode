{
  "name": "wscode",
  "displayName": "WSCode - Instant Inference",
  "description": "Unofficial extension that enables you to chat with Cerebras Inference directly within VSCode",
  "version": "0.10.0",
  "publisher": "sairyuichi",
  "repository": "https://github.com/ryuichis/vscode-extension-wscode",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "icon": "resources/wscode-ext-icn.png",
  "contributes": {
    "commands": [
      {
        "command": "wscode.ask",
        "title": "WSCode: Ask Cerebras Inference"
      },
      {
        "command": "wscode.setupApiKey",
        "title": "WSCode: Setup API Key for Cerebras Inference"
      },
      {
        "command": "wscode.indexWorkspace",
        "title": "WSCode: Index Workspace for Context"
      },
      {
        "command": "wscode.clearWorkspaceIndex",
        "title": "WSCode: Clear Workspace Index"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "WSCode",
      "properties": {
        "wscode.apiKey": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "API Key for Cerebras Inference"
        },
        "wscode.maxIndexedFiles": {
          "type": "number",
          "default": 1000,
          "description": "Maximum number of files to index in the workspace"
        },
        "wscode.fileExtensionsToIndex": {
          "type": "string",
          "default": "**/*.{js,ts,py,java,md,html,css,json,c,cpp,h,hpp,cs,go,rs,php,rb,swift,kt,scala}",
          "description": "File patterns to include in workspace indexing (glob pattern)"
        },
        "wscode.excludeFromIndex": {
          "type": "string",
          "default": "**/node_modules/**,**/dist/**,**/build/**,**/.git/**,**/venv/**,**/__pycache__/**",
          "description": "Patterns to exclude from workspace indexing (comma-separated glob patterns)"
        },
        "wscode.maxContextLength": {
          "type": "number",
          "default": 8000,
          "description": "Maximum length of context to send to Cerebras API"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wscodeView",
          "title": "WSCode",
          "icon": "resources/wscode-view-icn.png"
        }
      ]
    },
    "views": {
      "wscodeView": [
        {
          "icon": "resources/wscode-view-icn.png",
          "type": "webview",
          "id": "cerebrasInferenceView",
          "name": "Cerebras Inference"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^9.16.0"
  },
  "dependencies": {
    "@cerebras/cerebras_cloud_sdk": "^1.15.0",
    "hnswlib-node": "^1.4.2",
    "marked": "^15.0.4"
  }
}
